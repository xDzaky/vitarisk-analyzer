# Server
PORT=3000
NODE_ENV=development

# Machine Learning service URL
# Local example: http://localhost:5001
# Production example: https://xdzaky-vitarisk-ml.hf.space
FLASK_URL=http://localhost:5001

# PostgreSQL / Neon
DATABASE_URL=

# Nearby hospital search config
HOSPITAL_CACHE_TTL_MS=300000
OVERPASS_TIMEOUT_MS=20000

# Google Sign-In
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# JWT
JWT_SECRET=change-this-to-random-secret
JWT_EXPIRES_IN=7d

# Development login
ALLOW_DEV_LOGIN=false

# CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Chatbot config
CHATBOT_PROVIDER=openrouter
CHATBOT_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=your_openrouter_api_key_here
